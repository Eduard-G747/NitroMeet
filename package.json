{
  "name": "nitromeet",
  "productName": "NitroMeet",
  "version": "0.1.0",
  "description": "Self-hosted, end-to-end encrypted video meetings with a built-in notetaker. Lightweight by design.",
  "main": "./out/main/index.js",
  "author": "Eduard Georgescu",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist": "npm run typecheck && electron-vite build && electron-builder --win --x64",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "test:watch": "vitest",
    "dist:ci": "electron-vite build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "livekit-server-sdk": "^2.20.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "livekit-client": "^2.24.1",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  }
}